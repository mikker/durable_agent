# HTTP. SIDECAR_PORT wins over PORT, which foreman and overmind assign per process.
SIDECAR_PORT=4010
HOST=127.0.0.1
# Shared secret. Rails sends it as `Authorization: Bearer ...`; the sidecar sends it back on webhooks.
SIDECAR_TOKEN=change-me

# Postgres the Rails app owns. The sidecar only writes the agent_* mirror tables.
DATABASE_URL=postgres://localhost/slopdep_development

# pi-durable storage. One process owns this file at a time.
STORAGE_PATH=./data/harness.sqlite

# Default model for new conversations. OpenAI works with Sign in with ChatGPT (see README, "Sign in with ChatGPT")
# or OPENAI_API_KEY; Anthropic with ANTHROPIC_API_KEY. MODEL_PROVIDER=faux runs the scripted offline model.
MODEL_PROVIDER=openai
MODEL_ID=gpt-6.1-sol
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Name shown on the ChatGPT consent screen and sent to OpenAI as the agent name.
AGENT_NAME=slopdep

# Where the agent's built-in file/shell tools operate when a conversation has no cwd of its own.
WORKSPACE_ROOT=./data/workspace
# Give the model read/edit/write/bash tools on this host. Off by default: it is a security decision.
ENABLE_CODING_TOOLS=false

# Rails internal API base URL. Enables the example `lookup_record` tool and report webhooks.
# RAILS_URL=http://127.0.0.1:3000
RAILS_WEBHOOK_PATH=/internal/agent/reports

# Which conversation documents to mirror into Postgres. `all`, or a comma list such as `pi.agent,pi.inbox,pi.usage`.
# `pi.live` changes up to every 100 ms while the model streams; leave it out if the UI streams via SSE instead.
MIRROR_DOCS=all
