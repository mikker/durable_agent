# Only for running the sidecar by hand (`npm run dev`). `bin/rails durable_agent:sidecar` sets all of these from
# Rails configuration. Relative paths resolve against the working directory.

# The app's primary Postgres. The sidecar only writes the durable_agent_* mirror tables (run the gem's migration first).
DATABASE_URL=postgres://localhost/myapp_development

# Shared secret. Rails sends it as `Authorization: Bearer ...`; the sidecar sends it back when it calls Rails tools.
DURABLE_AGENT_TOKEN=change-me

DURABLE_AGENT_HOST=127.0.0.1
DURABLE_AGENT_PORT=4010

# Where Rails answers GET /durable_agent/tools and POST /durable_agent/tools/:name. Unset: no tools.
DURABLE_AGENT_RAILS_URL=http://127.0.0.1:3000

# Default model as provider/modelId. `faux/faux-1` runs pi-ai's scripted offline model.
DURABLE_AGENT_MODEL=openai/gpt-6.1-sol
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# pi-durable's SQLite file. One process owns it at a time.
DURABLE_AGENT_STORAGE_PATH=storage/durable_agent.sqlite
# cwd for built-in tools (unused in v0).
DURABLE_AGENT_WORKSPACE_ROOT=storage/durable_agent

# Name shown on the ChatGPT consent screen and sent to OpenAI as the agent name.
DURABLE_AGENT_NAME=myapp

# Which conversation documents to mirror: `all`, or a comma list such as `pi.agent,pi.inbox,pi.usage`.
# `pi.live` changes up to every 100 ms while the model streams.
DURABLE_AGENT_MIRROR_DOCS=all
